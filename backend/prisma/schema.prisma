generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(60)
  entity_name String   @db.VarChar(50)
  entity_id   String?  @db.VarChar(100)
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.VarChar(45)
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_audit_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_movements {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cash_session_id String        @db.Uuid
  movement_type   String        @db.VarChar(30)
  amount          Decimal       @db.Decimal(14, 2)
  reason          String
  user_id         String        @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  cash_sessions   cash_sessions @relation(fields: [cash_session_id], references: [id], onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model cash_registers {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String          @db.VarChar(50)
  branch_name   String          @default("Sede Chapinero") @db.VarChar(80)
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  cash_sessions cash_sessions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_sessions {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cash_register_id    String             @db.Uuid
  user_id             String             @db.Uuid
  opening_time        DateTime           @default(now()) @db.Timestamptz(6)
  closing_time        DateTime?          @db.Timestamptz(6)
  initial_cash_amount Decimal            @db.Decimal(14, 2)
  final_cash_expected Decimal?           @db.Decimal(14, 2)
  final_cash_counted  Decimal?           @db.Decimal(14, 2)
  discrepancy_amount  Decimal?           @db.Decimal(14, 2)
  status              String             @default("OPEN") @db.VarChar(20)
  notes               String?
  cash_movements      cash_movements[]
  cash_registers      cash_registers     @relation(fields: [cash_register_id], references: [id], onUpdate: NoAction)
  users               users              @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  sales               sales[]
  utility_payments    utility_payments[]
}

model categories {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String     @unique @db.VarChar(80)
  icon       String?    @db.VarChar(40)
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  products   products[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customer_requests {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_code        String   @unique @db.VarChar(30)
  customer_name      String   @db.VarChar(150)
  customer_contact   String   @db.VarChar(100)
  request_type       String   @db.VarChar(30)
  description        String
  status             String   @default("RECIBIDA") @db.VarChar(20)
  resolution_notes   String?
  created_by_user_id String   @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  users              users    @relation(fields: [created_by_user_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customers {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_number String?  @unique @db.VarChar(30)
  full_name       String   @default("Cliente Ocasional") @db.VarChar(150)
  phone           String?  @db.VarChar(30)
  address         String?  @db.VarChar(150)
  credit_limit    Decimal  @default(0.00) @db.Decimal(14, 2)
  current_debt    Decimal  @default(0.00) @db.Decimal(14, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  sales           sales[]
}

model employees {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_number   String   @unique @db.VarChar(30)
  full_name         String   @db.VarChar(150)
  position          String   @db.VarChar(60)
  phone             String   @db.VarChar(30)
  hire_date         DateTime @db.Date
  emergency_contact String?  @db.VarChar(150)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sale_id         String   @db.Uuid
  payment_method  String   @db.VarChar(30)
  amount          Decimal  @db.Decimal(14, 2)
  amount_tendered Decimal  @default(0.00) @db.Decimal(14, 2)
  change_returned Decimal  @default(0.00) @db.Decimal(14, 2)
  reference_code  String?  @db.VarChar(100)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  sales           sales    @relation(fields: [sale_id], references: [id], onUpdate: NoAction)

  @@index([sale_id], map: "idx_payments_sale")
}

model permissions {
  id               String             @id @db.VarChar(60)
  module           String             @db.VarChar(40)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_batches {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id         String            @db.Uuid
  batch_number       String            @db.VarChar(50)
  expiration_date    DateTime          @db.Date
  initial_quantity   Decimal           @db.Decimal(12, 3)
  remaining_quantity Decimal           @db.Decimal(12, 3)
  is_active          Boolean           @default(true)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  products           products          @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  sale_details       sale_details[]
  stock_movements    stock_movements[]

  @@index([product_id, expiration_date], map: "idx_batches_product_exp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id      String             @db.Uuid
  sku              String             @unique @db.VarChar(50)
  barcode          String?            @unique @db.VarChar(50)
  name             String             @db.VarChar(150)
  description      String?
  unit_of_measure  String             @default("UNIDAD") @db.VarChar(20)
  cost_price       Decimal            @db.Decimal(14, 2)
  sale_price       Decimal            @db.Decimal(14, 2)
  tax_rate         Decimal            @default(0.00) @db.Decimal(5, 2)
  min_stock        Decimal            @default(5.000) @db.Decimal(12, 3)
  location_shelf   String?            @db.VarChar(50)
  image_url        String?
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  product_batches  product_batches[]
  categories       categories         @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  purchase_details purchase_details[]
  sale_details     sale_details[]
  stock_movements  stock_movements[]
  stocks           stocks?

  @@index([is_active, name], map: "idx_products_active_name")
  @@index([category_id], map: "idx_products_category")
  @@index([sku], map: "idx_products_sku")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_details {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchase_id     String    @db.Uuid
  product_id      String    @db.Uuid
  batch_number    String?   @db.VarChar(50)
  expiration_date DateTime? @db.Date
  quantity        Decimal   @db.Decimal(12, 3)
  unit_cost       Decimal   @db.Decimal(14, 2)
  total_cost      Decimal   @db.Decimal(14, 2)
  products        products  @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  purchases       purchases @relation(fields: [purchase_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchases {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplier_id             String             @db.Uuid
  supplier_invoice_number String             @db.VarChar(50)
  user_id                 String             @db.Uuid
  total_cost              Decimal            @db.Decimal(14, 2)
  status                  String             @default("RECEIVED") @db.VarChar(20)
  notes                   String?
  received_at             DateTime           @default(now()) @db.Timestamptz(6)
  purchase_details        purchase_details[]
  suppliers               suppliers          @relation(fields: [supplier_id], references: [id], onUpdate: NoAction)
  users                   users              @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model role_permissions {
  role_id       String      @db.VarChar(30)
  permission_id String      @db.VarChar(60)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  id               String             @id @db.VarChar(30)
  name             String             @db.VarChar(50)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  users            users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sale_details {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sale_id         String           @db.Uuid
  product_id      String           @db.Uuid
  batch_id        String?          @db.Uuid
  quantity        Decimal          @db.Decimal(12, 3)
  unit_cost       Decimal          @db.Decimal(14, 2)
  unit_price      Decimal          @db.Decimal(14, 2)
  discount_rate   Decimal          @default(0.00) @db.Decimal(5, 2)
  tax_rate        Decimal          @default(0.00) @db.Decimal(5, 2)
  tax_amount      Decimal          @default(0.00) @db.Decimal(14, 2)
  subtotal        Decimal          @db.Decimal(14, 2)
  total           Decimal          @db.Decimal(14, 2)
  product_batches product_batches? @relation(fields: [batch_id], references: [id], onUpdate: NoAction)
  products        products         @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  sales           sales            @relation(fields: [sale_id], references: [id], onUpdate: NoAction)

  @@index([sale_id], map: "idx_sale_details_sale")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sales {
  id                                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sale_number                          String         @unique @db.VarChar(40)
  cash_session_id                      String         @db.Uuid
  user_id                              String         @db.Uuid
  customer_id                          String?        @db.Uuid
  subtotal                             Decimal        @db.Decimal(14, 2)
  discount_total                       Decimal        @default(0.00) @db.Decimal(14, 2)
  tax_total                            Decimal        @default(0.00) @db.Decimal(14, 2)
  total                                Decimal        @db.Decimal(14, 2)
  status                               String         @default("COMPLETED") @db.VarChar(20)
  voided_reason                        String?
  voided_by_user_id                    String?        @db.Uuid
  created_at                           DateTime       @default(now()) @db.Timestamptz(6)
  payments                             payments[]
  sale_details                         sale_details[]
  cash_sessions                        cash_sessions  @relation(fields: [cash_session_id], references: [id], onUpdate: NoAction)
  customers                            customers?     @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  users_sales_user_idTousers           users          @relation("sales_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)
  users_sales_voided_by_user_idTousers users?         @relation("sales_voided_by_user_idTousers", fields: [voided_by_user_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_sales_date")
  @@index([cash_session_id], map: "idx_sales_session")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_movements {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id      String           @db.Uuid
  batch_id        String?          @db.Uuid
  movement_type   String           @db.VarChar(35)
  quantity        Decimal          @db.Decimal(12, 3)
  previous_stock  Decimal          @db.Decimal(12, 3)
  new_stock       Decimal          @db.Decimal(12, 3)
  reference_id    String?          @db.VarChar(100)
  notes           String?
  user_id         String           @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  product_batches product_batches? @relation(fields: [batch_id], references: [id], onUpdate: NoAction)
  products        products         @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  users           users            @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([product_id, created_at(sort: Desc)], map: "idx_stock_movements_prod")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stocks {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id      String   @unique @db.Uuid
  current_stock   Decimal  @default(0.000) @db.Decimal(12, 3)
  last_updated_at DateTime @default(now()) @db.Timestamptz(6)
  products        products @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([product_id], map: "idx_stocks_product")
}

model suppliers {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nit_or_id          String      @unique @db.VarChar(30)
  company_name       String      @db.VarChar(150)
  contact_name       String?     @db.VarChar(100)
  phone              String      @db.VarChar(30)
  email              String?     @db.VarChar(120)
  visit_days         String?     @db.VarChar(50)
  payment_terms_days Int         @default(0)
  is_active          Boolean     @default(true)
  created_at         DateTime    @default(now()) @db.Timestamptz(6)
  purchases          purchases[]
}

model system_settings {
  key         String   @id @db.VarChar(60)
  value       String
  description String?
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
}

model users {
  id                                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                String              @unique @db.VarChar(150)
  username                             String              @unique @db.VarChar(50)
  password_hash                        String              @db.VarChar(255)
  pos_pin_hash                         String?             @db.VarChar(255)
  full_name                            String              @db.VarChar(150)
  role_id                              String              @db.VarChar(30)
  is_active                            Boolean             @default(true)
  created_at                           DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime            @default(now()) @db.Timestamptz(6)
  audit_logs                           audit_logs[]
  cash_movements                       cash_movements[]
  cash_sessions                        cash_sessions[]
  customer_requests                    customer_requests[]
  purchases                            purchases[]
  sales_sales_user_idTousers           sales[]             @relation("sales_user_idTousers")
  sales_sales_voided_by_user_idTousers sales[]             @relation("sales_voided_by_user_idTousers")
  stock_movements                      stock_movements[]
  roles                                roles               @relation(fields: [role_id], references: [id], onUpdate: NoAction)
  utility_payments                     utility_payments[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model utility_accounts {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_type     String             @db.VarChar(40)
  company_name     String             @db.VarChar(80)
  account_number   String             @db.VarChar(50)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  utility_payments utility_payments[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model utility_payments {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utility_account_id     String           @db.Uuid
  cash_session_id        String?          @db.Uuid
  bill_period            String           @db.VarChar(30)
  amount                 Decimal          @db.Decimal(14, 2)
  due_date               DateTime         @db.Date
  payment_date           DateTime         @default(now()) @db.Timestamptz(6)
  receipt_voucher_number String?          @db.VarChar(80)
  paid_by_user_id        String           @db.Uuid
  cash_sessions          cash_sessions?   @relation(fields: [cash_session_id], references: [id], onUpdate: NoAction)
  users                  users            @relation(fields: [paid_by_user_id], references: [id], onUpdate: NoAction)
  utility_accounts       utility_accounts @relation(fields: [utility_account_id], references: [id], onUpdate: NoAction)
}
